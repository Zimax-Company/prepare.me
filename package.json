{
  "name": "prepare-me",
  "private": true,
  "type": "module",
  "description": "prepare.me — interactive learning platform (Next.js React UI + API on MySQL)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/artisan.mjs migrate --force --seed --deploy && next build",
    "migrate": "node scripts/artisan.mjs migrate",
    "migrate:rollback": "node scripts/artisan.mjs migrate:rollback",
    "migrate:fresh": "node scripts/artisan.mjs migrate:fresh",
    "migrate:status": "node scripts/artisan.mjs migrate:status",
    "make:migration": "node scripts/artisan.mjs make:migration",
    "db:seed": "node scripts/artisan.mjs db:seed",
    "db:up": "docker compose up -d mysql",
    "course:convert": "node scripts/course.mjs convert",
    "course:validate": "node scripts/course.mjs validate",
    "course:import": "node scripts/course.mjs import",
    "course:sync": "node scripts/course.mjs sync"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "katex": "^0.16.47",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "speech-rule-engine": "^4.1.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9"
  }
}
